# Aplicacion NEXTRY ejecutada en CPL3; no modifica el kernel.
funcion inicio
    mostrar "NEXTRY protegido: aplicacion en modo usuario"
    entero suma = 0
    repetir 5 veces
        suma = suma + 2
    fin
    guardar_archivo "nota", "Archivo creado desde NEXTRY protegido"
    agregar_archivo "nota", ". Texto agregado"
    renombrar_archivo "nota", "nota_final"
    copiar_archivo "nota_final", "copia"
    borrar_archivo "nota_final"
    mostrar_archivo "copia"
    borrar_archivo "copia"
    afirmar suma == 10
    numero suma
fin
