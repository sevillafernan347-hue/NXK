# Ejecutable NXE2 cargado desde NXFS, sin integrarlo en el kernel.
funcion inicio
    mostrar "Aplicacion NEXTRY cargada desde disco"
    entero total = 6 * 7
    afirmar total == 42
    # Copiar y editar sin escribir en el volumen original.
    copiar_archivo "leeme.txt", "copia_disco"
    agregar_archivo "copia_disco", "COPIA_NXE2_EDITADA"
    mostrar_archivo "copia_disco"
    borrar_archivo "copia_disco"
    numero total
fin
