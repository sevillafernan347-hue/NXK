{
  "scopeName": "source.nxk-espanol",
  "patterns": [
    {"name": "comment.line.number-sign.nxk", "match": "#.*$"},
    {"name": "string.quoted.double.nxk", "begin": "\"", "end": "\"", "patterns": [{"name": "constant.character.escape.nxk", "match": "\\\\."}]},
    {"name": "keyword.control.nxk", "match": "\\b(funcion|función|fin|variable|constante|si|sino|mientras|repetir|veces|llamar|volver|detener|afirmar)\\b"},
    {"name": "support.function.nxk", "match": "\\b(mostrar|numero|número|memoria_usada|leer_puerto|escribir_puerto)\\b"},
    {"name": "constant.language.nxk", "match": "\\b(verdadero|falso)\\b"},
    {"name": "keyword.operator.nxk", "match": "\\b(y|o|no|y_bits|o_bits|xor_bits)\\b|==|!=|<=|>=|<<|>>|[=+*/%<>-]"},
    {"name": "constant.numeric.nxk", "match": "\\b(0[xX][0-9a-fA-F]+|[0-9]+)\\b"}
  ]
}
