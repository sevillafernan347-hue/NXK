{
  "comments": {"lineComment": "#"},
  "brackets": [["(", ")"]],
  "autoClosingPairs": [{"open": "(", "close": ")"}, {"open": "\"", "close": "\"", "notIn": ["string", "comment"]}],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(funcion|función|si|sino|mientras|repetir)\\b.*$",
    "decreaseIndentPattern": "^\\s*(fin|sino)\\b.*$"
  }
}
