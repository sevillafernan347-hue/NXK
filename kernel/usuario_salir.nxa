# Puerta INT 0x80: la CPU ya activo SS0/ESP0.
modo 32
externo nxk_usuario_pila_guardada
externo nxk_usuario_cs_guardado
direccion_adelante
cargar_pila32 ecx, 4
escribir_memoria32 nxk_usuario_cs_guardado, ecx
# Recuperar segmentos, pila kernel, registros preservados y banderas.
guardar32 eax
cargar16 ax, 16
segmento ds, ax
segmento es, ax
segmento fs, ax
segmento gs, ax
recuperar32 eax
leer_memoria32 esp, nxk_usuario_pila_guardada
recuperar32 edi
recuperar32 esi
recuperar32 ebx
recuperar32 ebp
recuperar_banderas32
devolver
