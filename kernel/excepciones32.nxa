# GUIA DE LECTURA NXK - kernel/excepciones32.nxa
# Entrada comun ante una excepcion x86: guarda registros y llama al manejador fatal; no regresa.
# Contexto y orden de estudio: ver LEER-CODIGO.md en la carpeta principal.
# Entrada fatal generada por NEXTRY ASM, modo protegido de 32 bits.
# El puente instala la direccion del manejador C en el inmediato de cargar32.
origen 0
modo 32
# Error auxiliar para excepciones sin codigo CPU; las otras entran en offset 2.
bytes 0x6a, 0
# El instalador sustituye el inmediato siguiente por el numero de vector.
bytes 0x6a, 0
desactivar_interrupciones
direccion_adelante
guardar_registros32
copiar32 esi, esp
alinear_pila16
# Reserva 12 bytes y apila el argumento: ESP queda alineado antes de CALL.
bytes 0x83, 0xec, 12
guardar32 esi
cargar32 eax, 0
llamar_registro eax
espera:
detener
saltar espera
